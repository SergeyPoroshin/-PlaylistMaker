<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="@dimen/header_height"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_16"
        android:paddingEnd="@dimen/space_16"
        android:text="@string/app_name"
        android:textColor="@color/yp_white"
        android:textSize="@dimen/text_size_22" />

    <Button
        android:id="@+id/searchButton"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginTop="@dimen/space_24"
        android:layout_marginEnd="@dimen/space_16"
        android:layout_weight="1"
        android:fontFamily="sans-serif-medium"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:letterSpacing="0"
        android:minHeight="0dp"
        android:text="@string/search"
        android:textAllCaps="false"
        android:textColor="@color/yp_black"
        android:textSize="@dimen/text_size_22"
        app:backgroundTint="@color/yp_white"
        app:cornerRadius="@dimen/button_corner_radius"
        app:icon="@drawable/ic_search"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.PlaylistMaker.MainButton"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/space_8"
        app:iconSize="@dimen/icon_size"
        app:iconTint="@color/yp_black" />

    <Button
        android:id="@+id/libraryButton"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginTop="@dimen/space_16"
        android:layout_marginEnd="@dimen/space_16"
        android:layout_weight="1"
        android:fontFamily="sans-serif-medium"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:letterSpacing="0"
        android:minHeight="0dp"
        android:text="@string/media_library"
        android:textAllCaps="false"
        android:textColor="@color/yp_black"
        android:textSize="@dimen/text_size_22"
        app:backgroundTint="@color/yp_white"
        app:cornerRadius="@dimen/button_corner_radius"
        app:icon="@drawable/ic_library"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.PlaylistMaker.MainButton"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/space_8"
        app:iconSize="@dimen/icon_size"
        app:iconTint="@color/yp_black" />

    <Button
        android:id="@+id/settingsButton"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginTop="@dimen/space_16"
        android:layout_marginEnd="@dimen/space_16"
        android:layout_marginBottom="@dimen/space_28"
        android:layout_weight="1"
        android:fontFamily="sans-serif-medium"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:letterSpacing="0"
        android:minHeight="0dp"
        android:text="@string/settings"
        android:textAllCaps="false"
        android:textColor="@color/yp_black"
        android:textSize="@dimen/text_size_22"
        app:backgroundTint="@color/yp_white"
        app:cornerRadius="@dimen/button_corner_radius"
        app:icon="@drawable/ic_settings"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.PlaylistMaker.MainButton"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/space_8"
        app:iconSize="@dimen/icon_size"
        app:iconTint="@color/yp_black" />

</LinearLayout>
